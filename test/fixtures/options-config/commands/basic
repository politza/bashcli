#!/usr/bin/env bash

declare -A options=()
declare -a multi=()
declare -a multiList=()
declare index

bashcli-options-parse options '' multi=multi multiList=multi-list -- "$@"

printf "%s\n" "boolean=${options[boolean]}"
printf "%s\n" "single=${options[single]}"
printf "%s\n" "enum=${options[enum]}"
for ((index = 0; index < ${#multi[@]}; ++index)); do
  printf "%s\n" "multi[${index}]=${multi[index]}"
done
for ((index = 0; index < ${#multiList[@]}; ++index)); do
  printf "%s\n" "multi-list[${index}]=${multiList[index]}"
done
